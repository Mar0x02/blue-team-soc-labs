    {
      "parameters": {
        "jsCode": "const level = $json.rule.level\n\nlet jira_priority\nif (level >= 12) {\n  jira_priority = \"1\";\n} else if (level >= 9) {\n  jira_priority = \"2\";\n} else if (level >= 6) {\n  jira_priority = \"3\";\n} else {\n  jira_priority = \"4\";\n}\n\nreturn {\n  ...$json,\n  jira_priority\n}"
      },
