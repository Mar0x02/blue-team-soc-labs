    {
      "parameters": {
        "jsCode": "const alert = $input.item.json.body || {};\n\nconst data = alert.data || {};\n\nlet details = [];\n\nconst srcip = data.srcip || data.src_ip;\nconst dstip = data.dstip || data.dst_ip;\nif (srcip) {\n  const sport = data.src_port ? ':' + data.src_port : '';\n  const dportVal = data.dest_port || data.dst_port;\n  const dport = dportVal ? ':' + dportVal : '';\n  details.push(`Network: ${srcip}${sport} -> ${dstip || '?'}${dport}`);\n}\nif (data.alert && data.alert.signature) {\n  details.push(`Suricata signature: ${data.alert.signature} (SID ${data.alert.signature_id || 'n/a'})`);\n  }\n\nif (data.audit) {\n  const exe = data.audit.exe || data.audit.command;\n  const euid = data.audit.euid || data.audit.uid;\n  if (exe) details.push(`Process: ${exe}${euid ? ' (uid=' + euid + ')' : ''}`);\n}\n\nif (data.syscheck && data.syscheck.path) {\n  details.push(`File: ${data.syscheck.path}${data.syscheck.event ? ' (' + data.syscheck.event + ')' : ''}`);\n}\n\nif (data.url) {\n  details.push(`HTTP: ${data.method || ''} ${data.url}`);\n}\n\nif (details.length === 0) {\n  details.push(`Raw log: ${alert.full_log || 'n/a'}`);\n}\n\nconst timestamp = alert.timestamp || \"\";\nlet waktu = \"\", tanggal = \"\";\nif (timestamp != \"\") {\n  const arr = timestamp.split(\"T\");\n  waktu = arr[1].split(\".\")[0];\n  tanggal = arr[0];\n}\n\nreturn {\n  json: {\n    ...alert,\n    enriched_summary: details.join('\\n'),\n    date: tanggal,\n    time: waktu\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
