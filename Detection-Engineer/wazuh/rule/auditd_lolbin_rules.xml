<!-- Local rules -->
<!-- Modify it at your will. -->

<group name="auditd,lolbin,command_injection,">

  <rule id="100300" level="7">
    <if_sid>80700</if_sid>
    <field name="audit.key">www_data_exec</field>
    <description>LOLBin: www-data (Apache) menjalankan proses baru "$(audit.command)" - indikasi command injection</description>
    <mitre>
      <id>T1059</id>
    </mitre>
  </rule>

  <rule id="100301" level="12">
    <if_sid>100300</if_sid>
    <field name="audit.command" type="pcre2">^(sh|bash|dash|ksh|zsh|perl|python|python2|python3|ruby|php|node|nodejs|gcc|cc|nc|ncat|netcat|socat|wget|curl|tftp|su|sudo|chmod|chown|mysql|mysqldump|psql|mkfifo|unshare|setcap)$</field>
    <description>LOLBin: www-data (Apache) menjalankan proses berbahaya "$(audit.command)" - indikasi command injection tingkat tinggi (shell/interpreter/network fetch/credential access/privesc)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>high_impact,</group>
  </rule>

</group>
