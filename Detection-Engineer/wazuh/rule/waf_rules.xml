<group name="modsecurity,waf,">

    <rule id="100700" level="0">
      <decoded_as>json</decoded_as>
      <field name="transaction.producer.modsecurity">\.+</field>
      <description>ModSecurity: audit event</description>
    </rule>

    <rule id="100701" level="7">
      <if_sid>100700</if_sid>
      <field name="transaction.is_interrupted">true</field>
      <description>WAF: request diblokir ModSecurity ($(transaction.request.method) $(transaction.request.uri)) dari $(transaction.client_ip)</description>
      <mitre><id>T1190</id></mitre>
      <group>attack,blocked,</group>
    </rule>

    <rule id="100702" level="10">
      <if_sid>100701</if_sid>
      <field name="transaction.messages">attack-command-injection</field>
      <description>WAF: Command Injection diblokir dari $(transaction.client_ip)</description>
      <mitre><id>T1190</id></mitre>
    </rule>

    <rule id="100703" level="10">
      <if_sid>100701</if_sid>
      <field name="transaction.messages">attack-sqli</field>
      <description>WAF: SQL Injection diblokir dari $(transaction.client_ip)</description>
      <mitre><id>T1190</id></mitre>
    </rule>

    <rule id="100704" level="10">
      <if_sid>100701</if_sid>
      <field name="transaction.messages">attack-xss</field>
      <description>WAF: XSS diblokir dari $(transaction.client_ip)</description>
      <mitre><id>T1190</id></mitre>
    </rule>

  </group>

<group name="safeline,waf,">

    <rule id="100705" level="0">
      <decoded_as>json</decoded_as>
      <field name="safeline.event_id">\.+</field>
      <description>SafeLine: attack event</description>
    </rule>

    <rule id="100706" level="7">
      <if_sid>100705</if_sid>
      <field name="safeline.action">^1$</field>
      <description>WAF: request diblokir SafeLine ($(safeline.url_path)) dari $(safeline.src_ip)</description>
      <mitre><id>T1190</id></mitre>
      <group>attack,blocked,</group>
    </rule>

    <rule id="100707" level="10">
      <if_sid>100706</if_sid>
      <field name="safeline.rule_id">^m_sqli$</field>
      <description>WAF: SQL Injection diblokir SafeLine dari $(safeline.src_ip)</description>
      <mitre><id>T1190</id></mitre>
    </rule>

  </group>

<group name="sentinel-waf,waf,">

    <rule id="100708" level="0">
      <decoded_as>sentinel-waf</decoded_as>
      <description>Sentinel WAF: event ModSecurity ($(http_method) $(url)) dari $(srcip)</description>
    </rule>

    <rule id="100709" level="12">
      <if_sid>100708</if_sid>
      <field name="waf_action">blocked</field>
      <field name="severity">CRITICAL</field>
      <description>WAF: request diblokir Sentinel WAF ($(http_method) $(url)) dari $(srcip) dengan $(severity) category $(category)</description>
      <mitre><id>T1190</id></mitre>
      <group>attack,blocked,</group>
    </rule>
    
    <rule id="100710" level="9">
      <if_sid>100708</if_sid>
      <field name="waf_action">blocked</field>
      <field name="severity">ERROR</field>
      <description>WAF: request diblokir Sentinel WAF ($(http_method) $(url)) dari $(srcip) dengan $(severity) category $(category)</description>
      <mitre><id>T1190</id></mitre>
      <group>attack,blocked,</group>
    </rule>

  </group>