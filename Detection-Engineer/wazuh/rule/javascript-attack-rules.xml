<!-- Local rules -->
<!-- Modify it at your will. -->

<group name="javascript_attacks,client_side_trust,web,attack,">

  <rule id="100500" level="0">
    <if_sid>31108</if_sid>
    <url type="pcre2">(?i)vulnerabilities/javascript</url>
    <description>Request ke modul JavaScript Attacks (DVWA) - $(url)</description>
  </rule>

  <rule id="100501" level="2">
    <if_sid>100500</if_sid>
    <field name="referer" type="pcre2" negate="yes">^-$</field>
    <description>JS Attacks: submission dengan Referer ada - pola normal browser di $(url)</description>
  </rule>

  <rule id="100502" level="5">
    <if_sid>100500</if_sid>
    <field name="referer" type="pcre2">^-$</field>
    <description>JS Attacks: submission TANPA Referer di $(url) - anomali, indikasi request gak lewat navigasi normal (kemungkinan script langsung POST)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

  <rule id="100503" level="10">
    <if_sid>100500</if_sid>
    <field name="user_agent" type="pcre2">(?i)(python-requests|curl/|wget/|go-http-client|postmanruntime|libwww-perl|scrapy|node-fetch|axios/|^-$)</field>
    <description>JS Attacks: User-Agent match known automation tool ($(user_agent)) di $(url) - indikasi submission via script, bukan browser</description>
    <mitre>
      <id>T1190</id>
    </mitre>
  </rule>

</group>
