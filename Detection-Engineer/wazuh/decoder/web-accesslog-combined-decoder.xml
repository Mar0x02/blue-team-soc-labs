<!-- Local decoders -->
<!-- Modify it at will. -->

<decoder name="web-accesslog-custom-js-attack">
  <type>web-log</type>
  <parent>web-accesslog</parent>
  <prematch type="pcre2">^\S+ \S+ \S+ \[[^\]]+\] "\S+ \S+ \S+"</prematch>
  <regex type="pcre2">^(\S+) \S+ \S+ \[[^\]]+\] "(\S+) (\S+) \S+" (\d+) (\d+|-) "([^"]*)" "([^"]*)"$</regex>
  <order>srcip, protocol, url, id, size, referer, user_agent</order>
</decoder>
